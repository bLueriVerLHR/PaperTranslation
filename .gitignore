# All local paper inputs, retained work materials and generated reader output.
# dist/<slug>/work/ contains derivative works and verbatim figure extracts too.
/dist/

# Local survey prose and translated abstracts; anchored to keep src/survey tracked.
/survey/

# Harness configuration and the system-TEMP task junction.
/.pi/

# Defensive denylist for retired workspace folders. These are NOT storage conventions;
# new temporary/development state must use system TEMP via tools/dev-env.ps1.
/papers/
/.local/
/.tasks/
/.logs/
/.reports/
/.tmp/

# Python (defensive: normal development routes caches/environment to system TEMP)
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Node (tooling only)
node_modules/

# Editors and OS noise
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# Secrets
.env
.env.*
!.env.example

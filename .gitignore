# Sources, page composition and skills are tracked; these paths are not.
# dist/ holds generated pages and local reference extracts in the data root.
/dist/

# Local survey prose and translated abstracts; anchored to keep src/survey tracked.
/survey/

# Owner-approved source checkouts; independent Git history and licenses.
# Never stage or publish these external repositories as pipeline source.
/repositories/

# Harness configuration and the system-TEMP task junction.
/.pi/

# Defensive denylist for retired workspace folders. These are NOT storage conventions;
# new temporary/development state must use system TEMP.
/.local/
/.tasks/
/.logs/
/.reports/
/.tmp/

# Python (defensive: normal development routes caches/environment to system TEMP)
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Node (tooling only)
node_modules/

# Editors and OS noise
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# Secrets
.env
.env.*
!.env.example

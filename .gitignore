# Paper material: local-only, never published.
#
# Everything under papers/ derives from someone else's paper: the figure crops are verbatim
# extracts from the source PDF, the content is a translation (a derivative work) of the original
# text, and the manifests carry the papers' identity and section maps. None of it is covered by
# LICENSE, so it stays out of the public repository. The pipeline regenerates the figures from a
# PDF you supply yourself, and `git ls-files papers` must stay empty.
papers/

# Local-only and generated content
.tasks/
.local/
.logs/
.reports/
.tmp/
.pi/
dist/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Node (tooling only)
node_modules/

# Editors and OS noise
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# Secrets
.env
.env.*
!.env.example
